{
  "id": "no.lightguard",
  "version": "0.1.15",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Light Guard",
    "no": "Light Guard"
  },
  "description": {
    "en": "Motion-controlled room lighting with adjustable night lights.",
    "no": "Bevegelsesstyrt rombelysning med justerbart nattlys."
  },
  "tags": {
    "en": [
      "light",
      "automation",
      "room",
      "motion",
      "sensor",
      "door",
      "garage"
    ],
    "no": [
      "lys",
      "automasjon",
      "rom",
      "bevegelse",
      "sensor",
      "dor",
      "garasje"
    ]
  },
  "category": [
    "tools"
  ],
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "brandColor": "#e8441a",
  "permissions": [
    "homey:manager:api"
  ],
  "author": {
    "name": "Thomas Solvik"
  },
  "contributors": {
    "developers": [
      { "name": "Finn Cato Andersen" }
    ]
  },
  "support": "https://github.com/5olvik/easy-automation",
  "homepage": "https://github.com/5olvik/easy-automation/tree/lightsguard",
  "source": "https://github.com/5olvik/easy-automation/tree/lightsguard",
  "api": {
    "getDevices": {
      "method": "GET",
      "path": "/devices"
    },
    "getAutomations": {
      "method": "GET",
      "path": "/automations"
    },
    "saveAutomations": {
      "method": "POST",
      "path": "/automations"
    },
    "testAutomation": {
      "method": "POST",
      "path": "/test"
    },
    "getLogs": {
      "method": "GET",
      "path": "/logs"
    }
  },
  "flow": {
    "actions": [
      {
        "id": "run_group",
        "title": {
          "en": "Run automation group",
          "no": "Kjør automasjonsgruppe"
        },
        "titleFormatted": {
          "en": "Run automation group [[group]]",
          "no": "Kjør automasjonsgruppe [[group]]"
        },
        "args": [
          {
            "name": "group",
            "type": "autocomplete",
            "placeholder": {
              "en": "Select automation...",
              "no": "Velg automasjon..."
            }
          }
        ]
      },
      {
        "id": "override_group",
        "title": {
          "en": "Override automation group",
          "no": "Overstyr automasjonsgruppe"
        },
        "titleFormatted": {
          "en": "Override automation group [[group]]",
          "no": "Overstyr automasjonsgruppe [[group]]"
        },
        "args": [
          {
            "name": "group",
            "type": "autocomplete",
            "placeholder": {
              "en": "Select automation...",
              "no": "Velg automasjon..."
            }
          }
        ]
      },
      {
        "id": "cancel_override",
        "title": {
          "en": "Cancel override for automation group",
          "no": "Avbryt overstyring for automasjonsgruppe"
        },
        "titleFormatted": {
          "en": "Cancel override for [[group]]",
          "no": "Avbryt overstyring for [[group]]"
        },
        "args": [
          {
            "name": "group",
            "type": "autocomplete",
            "placeholder": {
              "en": "Select automation...",
              "no": "Velg automasjon..."
            }
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "room",
      "images": {
        "small": "/drivers/room/assets/images/small.jpg",
        "large": "/drivers/room/assets/images/large.jpg",
        "xlarge": "/drivers/room/assets/images/xlarge.jpg"
      },
      "name": {
        "en": "Room",
        "no": "Rom"
      },
      "class": "sensor",
      "platforms": [
        "local"
      ],
      "capabilities": [
        "alarm_motion",
        "onoff"
      ],
      "capabilitiesOptions": {
        "alarm_motion": {
          "title": {
            "en": "Occupied",
            "no": "Opptatt"
          },
          "setable": false,
          "getable": true
        },
        "onoff": {
          "title": {
            "en": "Automation active",
            "no": "Automasjon aktiv"
          },
          "titleTrue": {
            "en": "Automation enabled",
            "no": "Automasjon aktivert"
          },
          "titleFalse": {
            "en": "Automation disabled",
            "no": "Automasjon deaktivert"
          }
        }
      },
      "pair": [
        {
          "id": "start",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "motion_timeout",
          "type": "number",
          "label": {
            "en": "Motion timeout (minutes)",
            "no": "Bevegelsestimeout (minutter)"
          },
          "hint": {
            "en": "Fire the no-motion trigger after this many minutes without motion.",
            "no": "Utlos ingen-bevegelse-triggeren etter dette antall minutter uten bevegelse."
          },
          "value": 5,
          "min": 1,
          "max": 120,
          "units": {
            "en": "min",
            "no": "min"
          }
        }
      ]
    }
  ]
}
